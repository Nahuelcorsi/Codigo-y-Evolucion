---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import logo from '../assets/logo.png';
import { sitio, contacto, habilidades } from '../data/sitio';

const destacados = (await getCollection('proyectos', (p) => p.data.destacado))
  .sort((a, b) => a.data.orden - b.data.orden);
---
<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">hola, soy {sitio.autor}</p>
        <h1>Código <span class="amp">&amp;</span> <span class="evo">Evolución</span></h1>
        <p class="frase">{sitio.frase}</p>
        <p class="rol"><span>{sitio.rol}</span> · <span>{sitio.ubicacion}</span></p>
        <div class="acciones">
          <a class="btn btn-primary" href="/proyectos/">Ver proyectos</a>
          <a class="btn" href="#contacto">Contacto</a>
        </div>
      </div>
      <div class="hero-logo">
        <Image src={logo} alt="Logo de Código y Evolución: un cerebro de redes con los símbolos de código y un brote que crece" width={420} height={420} loading="eager" />
      </div>
    </div>
  </section>

  <section id="sobre-mi" class="section">
    <div class="container sobre">
      <div>
        <p class="eyebrow">sobre mí</p>
        <h2 class="section-title">De aprender HTML a resolver problemas reales</h2>
      </div>
      <div class="bio">
        {sitio.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="proyectos" class="section">
    <div class="container">
      <p class="eyebrow">proyectos</p>
      <h2 class="section-title">Lo que vengo construyendo</h2>
      <p class="lead">Sitios, apps y herramientas que uso yo, mi negocio u otras personas todos los días.</p>
      <div class="grid">
        {destacados.map((p) => <ProjectCard proyecto={p} />)}
      </div>
      <p class="ver-todos"><a class="btn" href="/proyectos/">Ver todos los proyectos →</a></p>
    </div>
  </section>

  <section id="habilidades" class="section">
    <div class="container">
      <p class="eyebrow">habilidades</p>
      <h2 class="section-title">Con qué trabajo</h2>
      <div class="skills">
        {habilidades.map((h) => (
          <div class="skill">
            <h3>{h.grupo}</h3>
            <ul>{h.items.map((i) => <li class="tag">{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contacto" class="section">
    <div class="container contacto">
      <p class="eyebrow">contacto</p>
      <h2 class="section-title">¿Tenés una idea o un problema para resolver?</h2>
      <p class="lead">Escribime por cualquiera de estos medios y lo charlamos.</p>
      <ul class="redes">
        {contacto.map((c) => <li><a class="btn" href={c.url} target="_blank" rel="noopener">{c.nombre}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 72px 0 88px; }
  .hero-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); font-weight: 800; text-transform: uppercase; letter-spacing: 0.01em; }
  .amp { color: var(--orange); }
  .evo { background: linear-gradient(90deg, var(--green), var(--cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .frase { font-size: 1.25rem; max-width: 34ch; margin: 0 0 12px; }
  .rol { color: var(--muted); font-family: var(--font-mono); font-size: 0.9rem; margin: 0 0 32px; }
  .acciones { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-logo { display: grid; place-items: center; }
  .hero-logo :global(img) { width: min(420px, 100%); filter: drop-shadow(0 0 60px rgba(95, 211, 141, 0.25)); animation: flotar 6s ease-in-out infinite; }
  @keyframes flotar { 50% { transform: translateY(-10px); } }

  .sobre { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; }
  .bio p { color: var(--muted); margin: 0 0 1em; }
  .bio p:first-child { color: var(--text); font-size: 1.1rem; }

  .ver-todos { margin: 40px 0 0; text-align: center; }

  .skills { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); margin-top: 32px; }
  .skill { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; }
  .skill h3 { font-size: 1rem; color: var(--green); }
  .skill ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }

  .contacto { text-align: center; }
  .contacto .lead { margin-inline: auto; }
  .redes { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; list-style: none; padding: 0; margin: 0; }

  @media (max-width: 820px) {
    .hero { padding: 40px 0 64px; }
    .hero-inner, .sobre { grid-template-columns: 1fr; gap: 28px; }
    .hero-logo { order: -1; }
    .hero-logo :global(img) { width: min(240px, 70%); }
  }
</style>
