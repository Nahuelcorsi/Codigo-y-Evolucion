---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import logo from '../assets/logo.png';
import { sitio, contacto, habilidades, servicios, proceso, linkWhatsapp } from '../data/sitio';
import IconoWhatsapp from '../components/IconoWhatsapp.astro';

const destacados = (await getCollection('proyectos', (p) => p.data.destacado))
  .sort((a, b) => a.data.orden - b.data.orden);
---
<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="disponible"><span class="punto" aria-hidden="true"></span>Disponible para nuevos proyectos</p>
        <h1>Código <span class="amp">&amp;</span> <span class="evo">Evolución</span></h1>
        <p class="frase">{sitio.frase}</p>
        <p class="rol">{sitio.autor} · {sitio.rol} · {sitio.ubicacion}</p>
        <div class="acciones">
          <a class="btn btn-primary btn-wa" href={linkWhatsapp()} target="_blank" rel="noopener"><IconoWhatsapp size={18} />Contame tu proyecto</a>
          <a class="btn" href="/proyectos/">Ver trabajos</a>
        </div>
      </div>
      <div class="hero-logo">
        <button type="button" class="logo-btn" id="logo-giro" aria-pressed="false" aria-label="Hacer girar el logo">
          <Image src={logo} alt="Logo de Código y Evolución: un cerebro de redes con los símbolos de código y un brote que crece" width={420} height={420} loading="eager" />
        </button>
        <p class="pista" aria-hidden="true">tocá el logo</p>
      </div>
    </div>
    <div class="container">
      <ul class="pilares" aria-label="Cómo trabajo">
        <li><strong>De punta a punta</strong><span>Diseño, desarrollo, base de datos y publicación.</span></li>
        <li><strong>Código propio</strong><span>Sin plantillas ni constructores, hecho para cada proyecto.</span></li>
        <li><strong>Pensado para el celular</strong><span>Rápido, claro y fácil de usar en cualquier pantalla.</span></li>
        <li><strong>Proyectos en uso real</strong><span>Sistemas que hoy usan negocios y profesionales.</span></li>
      </ul>
    </div>
  </section>

  <section id="servicios" class="section">
    <div class="container">
      <p class="eyebrow">servicios</p>
      <h2 class="section-title">Qué puedo hacer por tu proyecto</h2>
      <p class="lead">Desde una página para presentar tu negocio hasta el sistema con el que lo administrás.</p>
      <div class="servicios">
        {servicios.map((sv) => (
          <article class="servicio">
            <h3>{sv.titulo}</h3>
            <p>{sv.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="proyectos" class="section">
    <div class="container">
      <div class="cabecera">
        <div>
          <p class="eyebrow">trabajos</p>
          <h2 class="section-title">Proyectos seleccionados</h2>
          <p class="lead">Sistemas y herramientas que hoy se usan en negocios reales y en mi día a día.</p>
        </div>
        <a class="btn" href="/proyectos/">Ver todos →</a>
      </div>
      <div class="grid grid-2">
        {destacados.map((p) => <ProjectCard proyecto={p} />)}
      </div>
    </div>
  </section>

  <section id="proceso" class="section">
    <div class="container">
      <p class="eyebrow">proceso</p>
      <h2 class="section-title">Cómo trabajamos</h2>
      <p class="lead">Un proceso simple, con avances visibles en cada etapa.</p>
      <ol class="pasos">
        {proceso.map((paso, i) => (
          <li class="paso">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{paso.titulo}</h3>
            <p>{paso.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="sobre-mi" class="section">
    <div class="container sobre">
      <div>
        <p class="eyebrow">sobre mí</p>
        <h2 class="section-title">Programador y también dueño de un negocio</h2>
      </div>
      <div class="bio">
        {sitio.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="habilidades" class="section">
    <div class="container">
      <p class="eyebrow">tecnologías</p>
      <h2 class="section-title">Con qué trabajo</h2>
      <div class="skills">
        {habilidades.map((h) => (
          <div class="skill">
            <h3>{h.grupo}</h3>
            <ul>{h.items.map((i) => <li class="tag">{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contacto" class="section">
    <div class="container">
      <div class="cta">
        <p class="eyebrow">contacto</p>
        <h2 class="section-title">¿Tenés un proyecto en mente?</h2>
        <p class="lead">Contame qué necesitás y te respondo con una propuesta. Sin compromiso.</p>
        <a class="btn btn-primary btn-wa grande" href={linkWhatsapp()} target="_blank" rel="noopener"><IconoWhatsapp size={22} />Escribime por WhatsApp</a>
        <p class="o">o seguime en</p>
        <ul class="redes">
          {contacto.map((c) => <li><a class="btn" href={c.url} target="_blank" rel="noopener">{c.nombre}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  // Al tocar el logo empieza a girar (acelera de a poco). Al tocarlo de nuevo frena suave y vuelve a quedar derecho.
  // Solo se mueve si la persona lo toca, así que funciona igual con las animaciones del sistema desactivadas.
  const boton = document.getElementById('logo-giro');
  const img = boton?.querySelector('img');
  if (boton && img) {
    const VELOCIDAD = 300; // grados por segundo
    let angulo = 0, velocidad = 0, objetivo = 0, ultimo = 0, corriendo = false;

    const paso = (t: number) => {
      const dt = Math.min((t - ultimo) / 1000, 0.05);
      ultimo = t;
      velocidad += (objetivo - velocidad) * Math.min(dt * 2.5, 1);
      if (objetivo === 0 && velocidad < 40) {
        // Frenando: termina la vuelta y queda derecho.
        const destino = Math.ceil(angulo / 360) * 360;
        angulo += (destino - angulo) * Math.min(dt * 4, 1);
        if (destino - angulo < 0.3) { angulo = 0; velocidad = 0; corriendo = false; }
      } else {
        angulo += velocidad * dt;
      }
      img.style.transform = `rotate(${angulo}deg)`;
      if (corriendo) requestAnimationFrame(paso);
    };

    boton.addEventListener('click', () => {
      const activo = boton.getAttribute('aria-pressed') !== 'true';
      boton.setAttribute('aria-pressed', String(activo));
      objetivo = activo ? VELOCIDAD : 0;
      if (!corriendo) { corriendo = true; ultimo = performance.now(); requestAnimationFrame(paso); }
    });
  }
</script>

<style>
  .hero { padding: 72px 0 64px; }
  .hero-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); font-weight: 800; text-transform: uppercase; letter-spacing: 0.01em; }
  .amp { color: var(--orange); }
  .evo { background: linear-gradient(90deg, var(--green), var(--cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .frase { font-size: 1.25rem; max-width: 40ch; margin: 0 0 14px; }
  .rol { color: var(--muted); font-size: 0.92rem; margin: 0 0 32px; }
  .acciones { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-logo { display: grid; place-items: center; gap: 10px; }
  .logo-btn {
    all: unset; cursor: pointer; display: block; width: min(420px, 100%);
    border-radius: 50%; animation: flotar 6s ease-in-out infinite;
    -webkit-tap-highlight-color: transparent;
  }
  .logo-btn:focus-visible { outline: 2px solid var(--orange); outline-offset: 8px; }
  .logo-btn :global(img) {
    width: 100%; border-radius: 50%; will-change: transform;
    filter: drop-shadow(0 0 60px rgba(95, 211, 141, 0.25));
    transition: filter .4s ease;
  }
  .logo-btn:hover :global(img) { filter: drop-shadow(0 0 70px rgba(95, 211, 141, 0.4)); }
  .logo-btn[aria-pressed='true'] :global(img) { filter: drop-shadow(0 0 90px rgba(127, 216, 232, 0.55)); }
  .pista { margin: 0; font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); opacity: 0.7; }
  .pista::before { content: '> '; color: var(--orange); }
  @keyframes flotar { 50% { transform: translateY(-10px); } }


  .disponible { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 20px; padding: 6px 14px 6px 12px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); font-size: 0.85rem; color: var(--muted); }
  .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px rgba(95, 211, 141, 0.18); }

  .pilares { list-style: none; padding: 28px 0 0; margin: 56px 0 0; border-top: 1px solid var(--border); display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); }
  .pilares li { display: flex; flex-direction: column; gap: 4px; }
  .pilares strong { font-family: var(--font-display); font-size: 1rem; }
  .pilares span { color: var(--muted); font-size: 0.92rem; line-height: 1.5; }

  .servicios { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); }
  .servicio { padding: 26px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); }
  .servicio h3 { font-size: 1.1rem; margin-bottom: 10px; }
  .servicio p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .grid-2 { grid-template-columns: repeat(auto-fill, minmax(min(440px, 100%), 1fr)); }
  .cabecera { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 40px; }
  .cabecera .lead { margin-bottom: 0; }

  .pasos { list-style: none; padding: 0; margin: 0; display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); counter-reset: none; }
  .paso { border-top: 2px solid var(--border); padding-top: 18px; }
  .paso:first-child { border-top-color: var(--green-2); }
  .num { display: block; font-family: var(--font-mono); color: var(--orange); font-size: 0.85rem; margin-bottom: 8px; }
  .paso h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .paso p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .cta { text-align: center; padding: 56px 24px; border-radius: 20px; border: 1px solid var(--border);
    background: radial-gradient(600px 240px at 50% 0%, rgba(95, 211, 141, 0.12), transparent 70%), var(--surface); }
  .cta .lead { margin-inline: auto; }
  .grande { padding: 16px 28px; font-size: 1.05rem; }
  .o { color: var(--muted); font-size: 0.9rem; margin: 28px 0 12px; }

  .sobre { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; }
  .bio p { color: var(--muted); margin: 0 0 1em; }
  .bio p:first-child { color: var(--text); font-size: 1.1rem; }


  .skills { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); margin-top: 32px; }
  .skill { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; }
  .skill h3 { font-size: 1rem; color: var(--green); }
  .skill ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }

  .redes { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; list-style: none; padding: 0; margin: 0; }

  @media (max-width: 820px) {
    .hero { padding: 40px 0 64px; }
    .hero-inner, .sobre { grid-template-columns: 1fr; gap: 28px; }
    .hero-logo { order: -1; }
    .logo-btn { width: min(240px, 70%); }
  }
</style>
