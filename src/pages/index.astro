---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.png';
import { sitio, contacto, habilidades, servicios, proceso, linkWhatsapp } from '../data/sitio';
import IconoWhatsapp from '../components/IconoWhatsapp.astro';
import Intro from '../components/Intro.astro';
import ListaObras from '../components/ListaObras.astro';

const trabajos = (await getCollection('proyectos', (p) => p.data.destacado))
  .sort((a, b) => a.data.orden - b.data.orden);
const versiones = ['v0.1', 'v0.5', 'v0.9', 'v1.0'];
const letras = [...'Evolución'];
---
<Base>
  <Intro />

  <!-- LÁMINA 01 · PORTADA -->
  <section class="portada">
    <div class="container">
      <p class="lamina"><b>Lámina 01</b> Portada <span class="esc">Esc 1:1</span></p>
      <div class="portada-grid">
        <div class="portada-texto">
          <p class="estado"><span class="led" aria-hidden="true"></span>Tomando proyectos nuevos</p>
          <div class="cota cota-h" aria-hidden="true"><span>100% código propio</span></div>
          <h1 class="mega" aria-label="Código y Evolución">
            <span class="l1">Código <span class="amp">&amp;</span></span>
            <span class="l2" id="evolucion">{letras.map((c, i) => <span class="letra" style={`--i:${i}`}>{c}</span>)}</span>
          </h1>
          <p class="frase">{sitio.frase}</p>
          <div class="acciones">
            <a class="btn btn-wa" href={linkWhatsapp()} target="_blank" rel="noopener"><IconoWhatsapp size={18} />Contame tu proyecto</a>
            <a class="btn" href="#trabajos">Ver trabajos ↓</a>
          </div>
          <p class="firma">{sitio.autor} — {sitio.rol}, {sitio.ubicacion}</p>
        </div>

        <figure class="fig-logo">
          <div class="construccion" aria-hidden="true">
            <span class="eje eje-h"></span><span class="eje eje-v"></span>
            <span class="radio"><i>R 210</i></span>
          </div>
          <button type="button" class="logo-btn" id="logo-giro" aria-pressed="false" aria-label="Hacer girar el logo">
            <Image src={logo} alt="Logo de Código y Evolución: un cerebro de redes con los símbolos de código y un brote que crece" width={420} height={420} loading="eager" />
          </button>
          <figcaption>Fig. 1 — El logo. Tocalo y gira.</figcaption>
        </figure>
      </div>

      <ol class="specs" aria-label="Cómo trabajo">
        <li data-aparece><span>A</span><strong>De punta a punta</strong>Diseño, desarrollo, base de datos y publicación.</li>
        <li data-aparece><span>B</span><strong>Código propio</strong>Sin plantillas ni constructores de páginas.</li>
        <li data-aparece><span>C</span><strong>Primero el celular</strong>Rápido y claro en cualquier pantalla.</li>
        <li data-aparece><span>D</span><strong>En uso real</strong>Sistemas que hoy usan negocios de verdad.</li>
      </ol>
    </div>
  </section>

  <!-- LÁMINA 02 · SERVICIOS (lista de materiales) -->
  <section id="servicios" class="seccion">
    <div class="container">
      <p class="lamina"><b>Lámina 02</b> Servicios <span class="esc">Lista de materiales</span></p>
      <h2 class="titulo" data-aparece>Qué puedo<br /><em>fabricarte</em></h2>
      <div class="bom" role="table" aria-label="Servicios">
        <div class="bom-fila bom-cab" role="row">
          <span role="columnheader">Nº</span><span role="columnheader">Pieza</span><span role="columnheader">Especificación</span><span role="columnheader"><span class="sr">Consultar</span></span>
        </div>
        {servicios.map((sv, i) => (
          <a class="bom-fila" role="row" data-aparece href={linkWhatsapp(`Hola Nahuel, quería consultarte por: ${sv.titulo.toLowerCase()}.`)} target="_blank" rel="noopener">
            <span role="cell" class="n">{String(i + 1).padStart(2, '0')}</span>
            <span role="cell" class="pieza">{sv.titulo}</span>
            <span role="cell" class="spec">{sv.texto}</span>
            <span role="cell" class="ir">Consultar <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <p class="nota">Cada fila es un link: tocá la que te interesa y me escribís directo.</p>
    </div>
  </section>

  <!-- LÁMINA 03 · TRABAJOS -->
  <section id="trabajos" class="seccion">
    <div class="container">
      <p class="lamina"><b>Lámina 03</b> Trabajos <span class="esc">{String(trabajos.length).padStart(2, '0')} piezas</span></p>
      <h2 class="titulo" data-aparece>Cosas que ya<br /><em>funcionan</em></h2>
      <ListaObras proyectos={trabajos} />
      <a class="btn" href="/proyectos/">Ver todos los trabajos →</a>
    </div>
  </section>

  <!-- LÁMINA 04 · EVOLUCIÓN (proceso) -->
  <section id="evolucion" class="seccion">
    <div class="container">
      <p class="lamina"><b>Lámina 04</b> Proceso <span class="esc">De v0.1 a v1.0</span></p>
      <h2 class="titulo" data-aparece>Tu proyecto<br /><em>evoluciona</em></h2>
      <p class="intro-proceso">Como el software: por versiones. En cada una ves avances reales y opinás antes de seguir.</p>
      <ol class="versiones" id="versiones">
        {proceso.map((paso, i) => (
          <li class="version" data-aparece style={`--i:${i}`}>
            <span class="v">{versiones[i]}</span>
            <h3>{paso.titulo}</h3>
            <p>{paso.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LÁMINA 05 · SOBRE MÍ -->
  <section id="sobre-mi" class="seccion">
    <div class="container">
      <p class="lamina"><b>Lámina 05</b> Sobre mí <span class="esc">Código &amp; hierro</span></p>
      <div class="sobre">
        <blockquote class="cita" data-aparece>
          <p>Programo sistemas y atiendo un negocio de hierros. Los dos oficios me enseñaron lo mismo: <em>medir dos veces, cortar una.</em></p>
        </blockquote>
        <div class="bio" data-aparece>
          {sitio.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- LÁMINA 06 · CAJA DE HERRAMIENTAS -->
  <section id="herramientas" class="seccion">
    <div class="container">
      <p class="lamina"><b>Lámina 06</b> Herramientas <span class="esc">Inventario</span></p>
      <h2 class="titulo" data-aparece>Caja de<br /><em>herramientas</em></h2>
      <div class="caja">
        {habilidades.map((h, g) => (
          <div class="cajon" data-aparece>
            <h3><span>{String.fromCharCode(65 + g)}</span>{h.grupo}</h3>
            <ul>
              {h.items.map((it, i) => <li><span>{it}</span><i aria-hidden="true"></i><small>{String.fromCharCode(65 + g)}{i + 1}</small></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LÁMINA 07 · CONTACTO -->
  <section id="contacto" class="seccion contacto">
    <div class="container">
      <p class="lamina"><b>Lámina 07</b> Contacto <span class="esc">Por WhatsApp</span></p>
      <p class="pregunta" data-aparece>¿Tenés un proyecto en mente? Contame qué necesitás y te paso una propuesta, sin compromiso.</p>
      <a class="hablemos" href={linkWhatsapp()} target="_blank" rel="noopener" aria-label="Hablemos por WhatsApp">
        <span class="h-txt" aria-hidden="true">Hablemos</span>
        <span class="h-sub"><IconoWhatsapp size={20} /> WhatsApp · 11 3211-2203 <span aria-hidden="true">↗</span></span>
      </a>
      <ul class="redes">
        {contacto.map((c) => <li><a href={c.url} target="_blank" rel="noopener">{c.nombre} ↗</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<script>
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1) El logo gira al tocarlo: acelera de a poco y al tocarlo de nuevo frena y queda derecho.
  const boton = document.getElementById('logo-giro');
  const img = boton?.querySelector('img');
  if (boton && img) {
    const VELOCIDAD = 300;
    let angulo = 0, velocidad = 0, objetivo = 0, ultimo = 0, corriendo = false;
    const paso = (t: number) => {
      const dt = Math.min((t - ultimo) / 1000, 0.05);
      ultimo = t;
      velocidad += (objetivo - velocidad) * Math.min(dt * 2.5, 1);
      if (objetivo === 0 && velocidad < 40) {
        const destino = Math.ceil(angulo / 360) * 360;
        angulo += (destino - angulo) * Math.min(dt * 4, 1);
        if (destino - angulo < 0.3) { angulo = 0; velocidad = 0; corriendo = false; }
      } else {
        angulo += velocidad * dt;
      }
      img.style.transform = `rotate(${angulo}deg)`;
      if (corriendo) requestAnimationFrame(paso);
    };
    boton.addEventListener('click', () => {
      const activo = boton.getAttribute('aria-pressed') !== 'true';
      boton.setAttribute('aria-pressed', String(activo));
      objetivo = activo ? VELOCIDAD : 0;
      if (!corriendo) { corriendo = true; ultimo = performance.now(); requestAnimationFrame(paso); }
    });
  }

  // 2) "Evolución" reacciona al mouse: las letras cercanas se afinan, como si volvieran a un boceto.
  const palabra = document.getElementById('evolucion');
  if (palabra && matchMedia('(pointer: fine)').matches && !reducido) {
    const letras = [...palabra.querySelectorAll<HTMLElement>('.letra')];
    let pendiente = false, mx = -9999, my = -9999;
    const pintar = () => {
      pendiente = false;
      for (const l of letras) {
        const r = l.getBoundingClientRect();
        const d = Math.hypot(mx - (r.left + r.width / 2), my - (r.top + r.height / 2));
        const k = Math.max(0, 1 - d / 260);
        l.style.fontWeight = String(Math.round(900 - k * 780));
        l.style.color = k > 0.55 ? 'var(--naranja)' : '';
      }
    };
    addEventListener('pointermove', (e) => {
      mx = e.clientX; my = e.clientY;
      if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); }
    }, { passive: true });
  }

  // 3) El riel del proceso se llena a medida que bajás.
  const versiones = document.getElementById('versiones');
  if (versiones) {
    let pendiente = false;
    const medir = () => {
      pendiente = false;
      const r = versiones.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.75 - r.top) / (r.height + innerHeight * 0.25)));
      versiones.style.setProperty('--progreso', reducido ? '1' : p.toFixed(3));
      versiones.querySelectorAll<HTMLElement>('.version').forEach((v, i, todos) => {
        v.classList.toggle('alcanzada', p >= i / todos.length + 0.02 || reducido);
      });
    };
    addEventListener('scroll', () => { if (!pendiente) { pendiente = true; requestAnimationFrame(medir); } }, { passive: true });
    medir();
  }
</script>

<style>
  /* ---------- Portada ---------- */
  .portada { padding: 40px 0 96px; }
  .portada-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .estado {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 36px;
    font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 7px 12px; border: 1px solid var(--linea-fuerte);
  }
  .led { width: 8px; height: 8px; background: var(--verde); box-shadow: 0 0 10px var(--verde); animation: latido 2s ease-in-out infinite; }
  @keyframes latido { 50% { opacity: 0.3; box-shadow: none; } }

  /* Cotas: líneas de medida con topes en las puntas */
  .cota { position: relative; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; color: var(--azul); text-transform: uppercase; }
  .cota-h { height: 18px; margin-bottom: 10px; max-width: 640px; }
  .cota-h::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--azul); transform-origin: left; animation: trazar 1.2s cubic-bezier(.6, 0, .2, 1) .3s both; }
  .cota-h::after { content: ''; position: absolute; inset: 2px 0; border-inline: 1px solid var(--azul); }
  .cota-h span { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: var(--tinta); padding: 0 10px; white-space: nowrap; }
  @keyframes trazar { from { transform: scaleX(0); } }

  .mega {
    font-family: var(--font-display); font-weight: 900; text-transform: uppercase;
    line-height: 0.82; letter-spacing: -0.01em; margin: 0 0 28px;
    font-size: clamp(3.6rem, 12.5vw, 10.5rem);
  }
  .mega > span { display: block; }
  .amp { color: var(--naranja); font-weight: 400; }
  .l2 { color: var(--verde); white-space: nowrap; padding-top: 0.07em; }
  .letra { display: inline-block; transition: font-weight .25s ease, color .25s ease; animation: evolucionar 1.4s cubic-bezier(.3, 0, .2, 1) calc(.6s + var(--i) * 70ms) both; }
  @keyframes evolucionar {
    from { font-weight: 100; opacity: 0; transform: translateY(0.15em); }
    40% { opacity: 1; }
    to { font-weight: 900; transform: none; }
  }
  .frase { font-size: clamp(1.05rem, 1.8vw, 1.3rem); max-width: 44ch; margin: 0 0 30px; color: #c9d3e0; }
  .acciones { display: flex; gap: 12px; flex-wrap: wrap; }
  .firma { margin: 28px 0 0; font-family: var(--font-mono); font-size: 0.78rem; color: var(--tenue); }

  .fig-logo { margin: 0; position: relative; display: grid; place-items: center; padding: 40px 0 0; }
  .construccion { position: absolute; inset: 0 0 34px; pointer-events: none; }
  .eje { position: absolute; background: var(--linea-fuerte); }
  .eje-h { left: 0; right: 0; top: calc(50% + 20px); height: 1px; background-image: repeating-linear-gradient(90deg, var(--azul) 0 14px, transparent 14px 20px, var(--azul) 20px 22px, transparent 22px 28px); background-color: transparent; opacity: .45; }
  .eje-v { top: 0; bottom: 0; left: 50%; width: 1px; background-image: repeating-linear-gradient(180deg, var(--azul) 0 14px, transparent 14px 20px, var(--azul) 20px 22px, transparent 22px 28px); background-color: transparent; opacity: .45; }
  .radio { position: absolute; left: 50%; top: calc(50% + 20px); width: 46%; height: 1px; background: var(--naranja); transform: rotate(-38deg); transform-origin: left; }
  .radio i { position: absolute; right: 0; top: -20px; font-style: normal; font-family: var(--font-mono); font-size: 0.7rem; color: var(--naranja); transform: rotate(38deg); }
  .logo-btn {
    all: unset; cursor: pointer; position: relative; display: block; width: min(400px, 100%);
    border-radius: 50%; -webkit-tap-highlight-color: transparent;
  }
  .logo-btn::after { content: ''; position: absolute; inset: -14px; border: 1px dashed var(--linea-fuerte); border-radius: 50%; }
  .logo-btn:focus-visible { outline: 2px solid var(--naranja); outline-offset: 18px; }
  .logo-btn :global(img) { width: 100%; border-radius: 50%; will-change: transform; }
  .fig-logo figcaption { margin-top: 28px; font-family: var(--font-mono); font-size: 0.74rem; color: var(--tenue); letter-spacing: 0.04em; }

  .specs { list-style: none; margin: 80px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--linea-fuerte); }
  .specs li { padding: 20px; border-right: 1px solid var(--linea); color: var(--tenue); font-size: 0.92rem; line-height: 1.5; background: rgba(8, 16, 28, 0.6); }
  .specs li:last-child { border-right: 0; }
  .specs span { display: block; font-family: var(--font-mono); font-size: 0.72rem; color: var(--naranja); margin-bottom: 18px; }
  .specs strong { display: block; color: var(--texto); font-family: var(--font-display); font-size: 1.45rem; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1; margin-bottom: 8px; }

  /* ---------- Secciones ---------- */
  .seccion { padding: 96px 0; }

  /* Lista de materiales */
  .bom { border-top: 2px solid var(--texto); margin-bottom: 18px; }
  .bom-fila {
    position: relative; display: grid; grid-template-columns: 64px minmax(0, 1.1fr) minmax(0, 1.6fr) 130px; gap: 24px; align-items: baseline;
    padding: 26px 0; border-bottom: 1px solid var(--linea-fuerte); text-decoration: none; color: inherit;
  }
  .bom-cab { padding: 10px 0; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tenue); }
  a.bom-fila::before { content: ''; position: absolute; inset: 0 -12px; z-index: -1; background-image: repeating-linear-gradient(-45deg, rgba(99, 214, 144, 0.16) 0 1px, transparent 1px 8px); opacity: 0; transition: opacity .3s ease; }
  a.bom-fila:hover::before { opacity: 1; }
  .n { font-family: var(--font-mono); color: var(--naranja); font-size: 0.85rem; }
  .pieza { font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 800; text-transform: uppercase; line-height: 1; transition: color .25s ease; }
  a.bom-fila:hover .pieza { color: var(--verde); }
  .spec { color: #c3cddb; }
  .ir { font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tenue); text-align: right; transition: color .25s ease, transform .25s ease; }
  a.bom-fila:hover .ir { color: var(--verde); transform: translateX(6px); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* Evolución */
  .intro-proceso { color: #c3cddb; max-width: 52ch; margin: 0 0 56px; font-size: 1.1rem; }
  .versiones { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .versiones::before, .versiones::after { content: ''; position: absolute; left: 0; right: 0; top: 13px; height: 2px; background: var(--linea-fuerte); }
  .versiones::after { background: var(--verde); transform: scaleX(var(--progreso, 0)); transform-origin: left; box-shadow: 0 0 12px var(--verde); }
  .version { position: relative; padding-top: 48px; }
  .version::before { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 14px; background: var(--tinta); border: 2px solid var(--linea-fuerte); transform: rotate(45deg); transition: background .3s ease, border-color .3s ease; }
  .version.alcanzada::before { background: var(--verde); border-color: var(--verde); }
  .v { display: inline-block; font-family: var(--font-mono); font-size: 0.78rem; color: var(--tinta); background: var(--tenue); padding: 2px 8px; margin-bottom: 14px; transition: background .3s ease; }
  .version.alcanzada .v { background: var(--verde); }
  .version h3 { font-family: var(--font-display); font-size: 1.9rem; text-transform: uppercase; line-height: 1; margin-bottom: 10px; }
  .version p { margin: 0; color: #c3cddb; font-size: 0.95rem; }

  /* Sobre mí */
  .sobre { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 64px; align-items: start; }
  .cita { margin: 0; }
  .cita p { margin: 0; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.2rem, 4.6vw, 3.8rem); line-height: 0.95; }
  .cita em { font-style: normal; color: var(--naranja); }
  .bio { border-left: 1px solid var(--linea-fuerte); padding-left: 32px; }
  .bio p { margin: 0 0 1.1em; color: #c3cddb; }
  .bio p:first-child { color: var(--texto); }

  /* Caja de herramientas */
  .caja { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--linea-fuerte); background: rgba(8, 16, 28, 0.6); }
  .cajon { padding: 22px 20px 26px; border-right: 1px solid var(--linea); }
  .cajon:last-child { border-right: 0; }
  .cajon h3 { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tenue); margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--linea-fuerte); }
  .cajon h3 span { display: grid; place-items: center; width: 22px; height: 22px; background: var(--naranja); color: var(--tinta); font-weight: 600; }
  .cajon ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .cajon li { display: flex; align-items: baseline; gap: 8px; font-size: 0.98rem; }
  .cajon li i { flex: 1; border-bottom: 1px dotted var(--linea-fuerte); transform: translateY(-4px); }
  .cajon li small { font-family: var(--font-mono); font-size: 0.66rem; color: var(--tenue); }
  .cajon li:hover span { color: var(--verde); }

  /* Contacto */
  .contacto { padding-bottom: 40px; }
  .pregunta { font-size: clamp(1.1rem, 2vw, 1.4rem); max-width: 40ch; margin: 0 0 24px; color: #c9d3e0; }
  .hablemos { display: block; text-decoration: none; color: inherit; border-top: 2px solid var(--texto); border-bottom: 2px solid var(--texto); padding: 10px 0 22px; }
  .h-txt {
    display: block; font-family: var(--font-display); font-weight: 900; text-transform: uppercase;
    font-size: clamp(4.4rem, 19vw, 17rem); line-height: 0.86; letter-spacing: -0.01em;
    color: transparent; -webkit-text-stroke: 2px var(--verde);
    background: linear-gradient(var(--verde), var(--verde)) left / 0% 100% no-repeat;
    -webkit-background-clip: text; background-clip: text;
    transition: background-size .7s cubic-bezier(.7, 0, .2, 1);
  }
  .hablemos:hover .h-txt, .hablemos:focus-visible .h-txt { background-size: 100% 100%; }
  .h-sub { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 0.9rem; letter-spacing: 0.06em; color: var(--verde); }
  .redes { display: flex; flex-wrap: wrap; gap: 10px 28px; list-style: none; margin: 24px 0 0; padding: 0; font-family: var(--font-mono); font-size: 0.85rem; }
  .redes a { color: var(--tenue); text-decoration: none; }
  .redes a:hover { color: var(--texto); }

