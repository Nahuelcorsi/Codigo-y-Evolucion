---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { id: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const d = proyecto.data;
const { Content } = await render(proyecto);
const etiquetas = { web: 'Sitio web', software: 'App / software', robotica: 'Robótica' };
---
<Base titulo={d.titulo} descripcion={d.resumen}>
  <article class="section">
    <div class="container detalle">
      <a href="/proyectos/" class="volver">← Todos los proyectos</a>
      <p class="eyebrow">{etiquetas[d.categoria]} · {d.anio}</p>
      <h1>{d.titulo}</h1>
      <p class="resumen">{d.resumen}</p>
      <ul class="tags">{d.tecnologias.map((t) => <li class="tag">{t}</li>)}</ul>
      {(d.demo || d.repo) && (
        <div class="acciones">
          {d.demo && <a class="btn btn-primary" href={d.demo} target="_blank" rel="noopener">Ver online</a>}
          {d.repo && <a class="btn" href={d.repo} target="_blank" rel="noopener">Ver código</a>}
        </div>
      )}
      {d.imagen && (
        <div class:list={['imagen', { contener: d.imagenAjuste === 'contener' }]}>
          <Image src={d.imagen} alt={`Captura de ${d.titulo}`} width={1100} />
        </div>
      )}
      <div class="contenido"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .detalle { max-width: 860px; }
  .volver { display: inline-block; margin-bottom: 28px; color: var(--muted); font-size: 0.92rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .resumen { font-size: 1.15rem; color: var(--muted); margin: 0 0 20px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 28px; }
  .acciones { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; }
  .imagen { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-2); margin-bottom: 36px; }
  .imagen.contener { display: grid; place-items: center; padding: 24px; }
  .imagen.contener :global(img) { max-height: 520px; width: auto; }
  .contenido :global(p) { margin: 0 0 1.1em; }
  .contenido :global(strong) { color: var(--green); font-weight: 600; }
  .contenido :global(code) { font-family: var(--font-mono); font-size: 0.9em; background: var(--surface-2); padding: 2px 6px; border-radius: 6px; }
</style>
