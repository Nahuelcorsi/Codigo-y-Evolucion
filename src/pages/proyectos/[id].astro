---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IconoWhatsapp from '../../components/IconoWhatsapp.astro';
import { linkWhatsapp } from '../../data/sitio';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { id: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const d = proyecto.data;
const { Content } = await render(proyecto);
const escritorio = d.galeria.filter((g) => !g.movil);
const moviles = d.galeria.filter((g) => g.movil);
const etiquetas = { web: 'Aplicación web', software: 'Software a medida', robotica: 'Robótica' };
---
<Base titulo={d.titulo} descripcion={d.resumen}>
  <article class="caso">
    <div class="container">
      <p class="lamina"><a href="/proyectos/" class="volver">← Trabajos</a> <b>{etiquetas[d.categoria]}</b> <span class="esc">{d.anio}</span></p>
      <header class="encabezado">
        <h1 class="titulo">{d.titulo}</h1>
        <p class="resumen">{d.resumen}</p>
        {(d.demo || d.repo) && (
          <div class="acciones">
            {d.demo && <a class="btn btn-wa" href={d.demo} target="_blank" rel="noopener">Ver online ↗</a>}
            {d.repo && <a class="btn" href={d.repo} target="_blank" rel="noopener">Ver código ↗</a>}
          </div>
        )}
      </header>

      {d.imagen && (
        <div class:list={['imagen', { contener: d.imagenAjuste === 'contener' }]}>
          <Image src={d.imagen} alt={`Captura de ${d.titulo}`} width={1100} />
        </div>
      )}

      <div class="cuerpo">
        <div class="contenido">
          <h2><span>A</span>El proyecto</h2>
          <Content />
          {d.aspectos.length > 0 && (
            <>
              <h2><span>B</span>Lo más importante</h2>
              <ul class="aspectos">{d.aspectos.map((a) => <li>{a}</li>)}</ul>
            </>
          )}
        </div>
        <aside class="ficha" aria-label="Ficha técnica">
          <p class="ficha-tit">Ficha técnica</p>
          <dl>
            <div><dt>Rol</dt><dd>{d.rol}</dd></div>
            <div><dt>Tipo</dt><dd>{etiquetas[d.categoria]}</dd></div>
            <div><dt>Año</dt><dd>{d.anio}</dd></div>
            <div>
              <dt>Tecnologías</dt>
              <dd><ul class="tags">{d.tecnologias.map((t) => <li class="tag">{t}</li>)}</ul></dd>
            </div>
          </dl>
        </aside>
      </div>

      {d.galeria.length > 0 && (
        <section class="galeria" aria-labelledby="titulo-galeria">
          <h2 id="titulo-galeria"><span>C</span>Capturas</h2>
          {escritorio.length > 0 && (
            <div class="gal-escritorio">
              {escritorio.map((g) => (
                <figure>
                  <a href={g.src.src} target="_blank" rel="noopener"><Image src={g.src} alt={g.alt} width={900} /></a>
                  <figcaption><b>Fig. {d.galeria.indexOf(g) + 1}</b> {g.alt}</figcaption>
                </figure>
              ))}
            </div>
          )}
          {moviles.length > 0 && (
            <div class="gal-movil">
              {moviles.map((g) => (
                <figure>
                  <a href={g.src.src} target="_blank" rel="noopener"><Image src={g.src} alt={g.alt} width={360} /></a>
                  <figcaption><b>Fig. {d.galeria.indexOf(g) + 1}</b> {g.alt}</figcaption>
                </figure>
              ))}
            </div>
          )}
        </section>
      )}

      <div class="cierre">
        <p>¿Necesitás algo parecido para tu negocio?</p>
        <a class="btn btn-wa" href={linkWhatsapp(`Hola Nahuel, vi tu proyecto ${d.titulo} y quería consultarte por algo parecido.`)} target="_blank" rel="noopener"><IconoWhatsapp size={18} />Consultame por WhatsApp</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .caso { padding: 40px 0 24px; }
  .volver { color: var(--texto); text-decoration: none; border: 1px solid var(--linea-fuerte); padding: 4px 10px; letter-spacing: 0.1em; }
  .volver:hover { background: var(--texto); color: var(--tinta); }
  .encabezado { max-width: 900px; }
  .encabezado .titulo { font-size: clamp(3rem, 10vw, 8rem); color: var(--texto); }
  .resumen { font-size: clamp(1.1rem, 2vw, 1.35rem); color: #c9d3e0; margin: 0 0 28px; max-width: 48ch; }
  .acciones { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 48px; }
  .imagen { border: 1px solid var(--texto); background: var(--tinta-2); margin: 8px 0 72px; box-shadow: 14px 14px 0 rgba(99, 214, 144, 0.18); }
  .imagen.contener { display: grid; place-items: center; padding: 32px; }
  .imagen.contener :global(img) { max-height: 380px; width: auto; }
  .cuerpo { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 64px; align-items: start; }
  h2 { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-size: 2rem; font-weight: 800; text-transform: uppercase; line-height: 1; margin: 0 0 18px; }
  h2 span { display: grid; place-items: center; width: 26px; height: 26px; background: var(--naranja); color: var(--tinta); font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; }
  .contenido h2:not(:first-child) { margin-top: 44px; }
  .contenido :global(p) { margin: 0 0 1.1em; color: #c9d3e0; }
  .contenido :global(strong) { color: var(--texto); font-weight: 600; }
  .aspectos { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--linea-fuerte); }
  .aspectos li { padding: 12px 0 12px 30px; position: relative; color: #c9d3e0; border-bottom: 1px solid var(--linea); }
  .aspectos li::before { content: '+'; position: absolute; left: 4px; top: 10px; color: var(--verde); font-family: var(--font-mono); font-weight: 600; }
  .ficha { position: sticky; top: 88px; border: 1px solid var(--linea-fuerte); background: var(--tinta-2); }
  .ficha-tit { margin: 0; padding: 10px 16px; background: var(--texto); color: var(--tinta); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; }
  dl { margin: 0; }
  dl > div { padding: 14px 16px; border-bottom: 1px solid var(--linea); }
  dl > div:last-child { border-bottom: 0; }
  dt { font-family: var(--font-mono); font-size: 0.68rem; color: var(--naranja); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 4px; }
  dd { margin: 0; font-size: 0.95rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 6px 0 0; }
  .galeria { margin-top: 80px; }
  figure { margin: 0; }
  figure a { display: block; overflow: hidden; border: 1px solid var(--linea-fuerte); background: var(--tinta-2); transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
  figure a:hover { border-color: var(--texto); box-shadow: 8px 8px 0 rgba(99, 214, 144, 0.2); transform: translate(-3px, -3px); }
  figcaption { margin-top: 10px; color: var(--tenue); font-size: 0.86rem; }
  figcaption b { font-family: var(--font-mono); font-weight: 500; color: var(--naranja); font-size: 0.74rem; margin-right: 6px; }
  .gal-escritorio { display: grid; gap: 28px; grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr)); }
  .gal-escritorio :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .gal-movil { display: flex; flex-wrap: wrap; gap: 28px; }
  .gal-escritorio + .gal-movil { margin-top: 36px; }
  .gal-movil figure { width: min(220px, calc(50% - 14px)); }
  .gal-movil :global(img) { width: 100%; height: auto; }
  .cierre { margin-top: 88px; padding: 32px 0; border-top: 2px solid var(--texto); border-bottom: 1px solid var(--linea-fuerte); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .cierre p { margin: 0; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1; max-width: 18ch; }
  @media (max-width: 900px) {
    .cuerpo { grid-template-columns: 1fr; gap: 40px; }
    .ficha { position: static; }
  }
</style>
