---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListaObras from '../../components/ListaObras.astro';

const todos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
---
<Base titulo="Trabajos" descripcion="Todos los proyectos de Nahuel Corsi: sitios web, apps y software.">
  <section class="seccion">
    <div class="container">
      <p class="lamina"><b>Archivo</b> Todos los trabajos <span class="esc">{String(todos.length).padStart(2, '0')} piezas</span></p>
      <h1 class="titulo">Todos los<br /><em>trabajos</em></h1>
      <p class="bajada">Cada uno nació de una necesidad concreta. Entrá a cualquiera para ver qué hace y cómo está hecho.</p>
      <ListaObras proyectos={todos} />
    </div>
  </section>
</Base>

<style>
  .seccion { padding: 56px 0 40px; }
  .bajada { color: #c3cddb; max-width: 52ch; margin: 0 0 48px; font-size: 1.1rem; }
</style>
