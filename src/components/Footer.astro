---
import { sitio, contacto } from '../data/sitio';
const anio = new Date().getFullYear();
---
<footer class="footer">
  <div class="container inner">
    <p>© {anio} {sitio.autor} · {sitio.nombre}</p>
    <ul>
      {contacto.map((c) => <li><a href={c.url} target="_blank" rel="noopener">{c.nombre}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding: 28px 0; color: var(--muted); font-size: 0.9rem; }
  .inner { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  p { margin: 0; }
  ul { display: flex; gap: 18px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  a { color: var(--muted); }
  a:hover { color: var(--green); }
</style>
