---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { proyecto: CollectionEntry<'proyectos'>; }
const { proyecto } = Astro.props;
const d = proyecto.data;
const etiquetas = { web: 'Aplicación web', software: 'Software a medida', robotica: 'Robótica' };
---
<article class="card" data-categoria={d.categoria}>
  <a href={`/proyectos/${proyecto.id}/`} class="media" tabindex="-1" aria-hidden="true">
    {d.imagen ? (
      <Image src={d.imagen} alt="" width={640} class={d.imagenAjuste === 'contener' ? 'contener' : ''} />
    ) : (
      <span class="placeholder">&lt;/&gt;</span>
    )}
  </a>
  <div class="body">
    <p class="cat">{etiquetas[d.categoria]}</p>
    <h3><a href={`/proyectos/${proyecto.id}/`}>{d.titulo}</a></h3>
    <p class="resumen">{d.resumen}</p>
    <ul class="tags">
      {d.tecnologias.slice(0, 4).map((t) => <li class="tag">{t}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); overflow: hidden;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .card:hover { transform: translateY(-4px); border-color: rgba(95, 211, 141, 0.45); box-shadow: 0 18px 40px -20px rgba(95, 211, 141, 0.35); }
  .media { display: block; aspect-ratio: 16 / 10; background: var(--bg-2); overflow: hidden; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .media :global(img.contener) { object-fit: contain; padding: 16px; }
  .placeholder { display: grid; place-items: center; height: 100%; font-family: var(--font-mono); font-size: 2.5rem; color: var(--blue); }
  .body { padding: 20px 22px 24px; display: flex; flex-direction: column; flex: 1; }
  .cat { margin: 0 0 4px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--orange); }
  h3 { font-size: 1.2rem; margin-bottom: 8px; }
  h3 a { color: var(--text); }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .card { position: relative; }
  .resumen { color: var(--muted); font-size: 0.95rem; margin: 0 0 16px; flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }
</style>
