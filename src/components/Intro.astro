---
// Intro de la portada: el logo gira como una moneda y después se desarma por partes:
// la hoja crece y se va para arriba, los corchetes salen disparados a los costados
// y el resto del logo se achica y desaparece mientras aparece la página.
// (La variante anterior, con el logo partido en pedazos, está en IntroPedazos.astro.)
import { Image } from 'astro:assets';
import base from '../assets/intro/logo-base.png';
import izq from '../assets/intro/logo-izq.png';
import der from '../assets/intro/logo-der.png';
import hoja from '../assets/intro/logo-hoja.png';
---
<script is:inline>
  (function () {
    try {
      if (sessionStorage.getItem('intro-vista')) return;
    } catch (e) {}
    document.documentElement.classList.add('con-intro');
  })();
</script>
<div id="intro" class="intro" aria-hidden="true">
  <div class="escena">
    <div class="moneda">
      <Image class="capa base" src={base} alt="" width={260} height={260} loading="eager" />
      <Image class="capa izq" src={izq} alt="" width={260} height={260} loading="eager" />
      <Image class="capa der" src={der} alt="" width={260} height={260} loading="eager" />
      <Image class="capa hoja" src={hoja} alt="" width={260} height={260} loading="eager" />
    </div>
    <div class="brillo"></div>
  </div>
  <p class="marca">Código <b>&amp;</b> Evolución</p>
  <p class="saltar-intro">tocá para saltear</p>
</div>

<script>
  const intro = document.getElementById('intro');
  const raiz = document.documentElement;
  if (intro && raiz.classList.contains('con-intro')) {
    const rapida = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cerrada = false;
    const terminar = (demora: number) => {
      try { sessionStorage.setItem('intro-vista', '1'); } catch (e) {}
      intro.classList.add('saliendo');
      setTimeout(() => { raiz.classList.remove('con-intro'); intro.remove(); }, demora);
    };
    const cerrar = () => {
      if (cerrada) return;
      cerrada = true;
      if (rapida) return terminar(700);
      intro.classList.add('desarmando');
      setTimeout(() => terminar(1000), 700);
    };
    setTimeout(cerrar, rapida ? 900 : 2500);
    intro.addEventListener('click', cerrar);
    window.addEventListener('keydown', cerrar, { once: true });
  }
</script>

<style>
  .intro { display: none; }
  :global(html.con-intro) { overflow: hidden; }
  :global(html.con-intro) .intro {
    position: fixed; inset: 0; z-index: 100; isolation: isolate;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px;
    cursor: pointer; overflow: hidden;
  }
  .intro::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(500px 400px at 50% 45%, rgba(95, 211, 141, 0.10), transparent 70%), var(--bg);
    transition: opacity .9s ease;
  }
  .intro.saliendo { pointer-events: none; }
  .intro.saliendo::before { opacity: 0; }
  .intro.saliendo:not(.desarmando) { opacity: 0; transition: opacity .7s ease; }

  .escena { position: relative; width: min(260px, 60vw); aspect-ratio: 1; perspective: 900px; }
  .moneda { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; animation: girar 2s cubic-bezier(.2, .7, .2, 1) both; }
  .moneda :global(.capa) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .moneda :global(.base) { filter: drop-shadow(0 0 40px rgba(95, 211, 141, 0.35)); }
  .brillo {
    position: absolute; inset: -18%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(127, 216, 232, 0.35), transparent 60%);
    opacity: 0; animation: destello 1s ease-out 1.6s both;
  }
  .marca {
    margin: 0; font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.08em; font-size: clamp(1rem, 3.4vw, 1.4rem); color: var(--text);
    opacity: 0; animation: aparecer .7s ease 1.3s both;
  }
  .marca b { color: var(--orange); }
  .saltar-intro {
    position: absolute; bottom: calc(28px + env(safe-area-inset-bottom, 0px)); margin: 0;
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); opacity: 0;
    animation: aparecer .5s ease .8s both;
  }

  /* Desarme */
  .desarmando .moneda { animation: none; transform: none; }
  .desarmando .brillo { animation: none; opacity: 0; }
  .desarmando .marca, .desarmando .saltar-intro { animation: none; opacity: 0; transition: opacity .35s ease; }
  .desarmando .moneda :global(.izq) { animation: corchete-izq 1.1s cubic-bezier(.5, -0.3, .7, 1) forwards; }
  .desarmando .moneda :global(.der) { animation: corchete-der 1.1s cubic-bezier(.5, -0.3, .7, 1) .08s forwards; }
  .desarmando .moneda :global(.hoja) {
    transform-origin: 62% 34%;
    animation: hoja-crece 1.3s cubic-bezier(.3, .1, .3, 1) forwards;
  }
  .desarmando .moneda :global(.base) { animation: base-sale .8s ease .45s forwards; }

  @keyframes girar {
    0% { transform: rotateY(0deg) scale(0.4); opacity: 0; }
    15% { opacity: 1; }
    100% { transform: rotateY(1080deg) scale(1); opacity: 1; }
  }
  @keyframes destello {
    0% { opacity: 0; transform: scale(0.8); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: scale(1.3); }
  }
  @keyframes aparecer {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  /* Los corchetes toman impulso hacia adentro, saltan y salen girando a los costados */
  @keyframes corchete-izq {
    0% { transform: translate(0, 0) rotate(0); }
    18% { transform: translate(14%, 0) scale(0.9, 1.08); }
    45% { transform: translate(-40%, -18%) rotate(-140deg); opacity: 1; }
    100% { transform: translate(-260%, 30%) rotate(-540deg); opacity: 0; }
  }
  @keyframes corchete-der {
    0% { transform: translate(0, 0) rotate(0); }
    18% { transform: translate(-14%, 0) scale(0.9, 1.08); }
    45% { transform: translate(40%, -18%) rotate(140deg); opacity: 1; }
    100% { transform: translate(260%, 30%) rotate(540deg); opacity: 0; }
  }
  /* La hoja crece desde su tallo, brilla y se va flotando hacia arriba */
  @keyframes hoja-crece {
    0% { transform: scale(1); filter: drop-shadow(0 0 0 rgba(127, 216, 232, 0)); opacity: 1; }
    40% { transform: scale(1.9) rotate(-8deg); filter: drop-shadow(0 0 18px rgba(127, 216, 232, 0.8)); opacity: 1; }
    100% { transform: translate(-6%, -170%) scale(2.4) rotate(6deg); filter: drop-shadow(0 0 24px rgba(127, 216, 232, 0.6)); opacity: 0; }
  }
  @keyframes base-sale {
    to { transform: scale(0.7); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .moneda, .brillo, .marca, .saltar-intro { animation: none; opacity: 1; }
    .brillo { opacity: 0; }
  }
</style>
