---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---
<script is:inline>
  // La intro se muestra una sola vez por visita (pestaña). Sin JavaScript no aparece y la página se ve igual.
  (function () {
    try {
      if (sessionStorage.getItem('intro-vista')) return;
    } catch (e) {}
    document.documentElement.classList.add('con-intro');
  })();
</script>
<div id="intro" class="intro" aria-hidden="true">
  <div class="escena">
    <div class="moneda">
      <Image src={logo} alt="" width={260} height={260} loading="eager" />
    </div>
    <div class="brillo"></div>
  </div>
  <p class="marca">Código <b>&amp;</b> Evolución</p>
  <p class="saltar-intro">tocá para saltear</p>
</div>

<script>
  const intro = document.getElementById('intro');
  const raiz = document.documentElement;
  if (intro && raiz.classList.contains('con-intro')) {
    let cerrada = false;
    const cerrar = () => {
      if (cerrada) return;
      cerrada = true;
      try { sessionStorage.setItem('intro-vista', '1'); } catch (e) {}
      intro.classList.add('saliendo');
      setTimeout(() => { raiz.classList.remove('con-intro'); intro.remove(); }, 700);
    };
    const rapida = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(cerrar, rapida ? 900 : 2900);
    intro.addEventListener('click', cerrar);
    window.addEventListener('keydown', cerrar, { once: true });
  }
</script>

<style>
  .intro { display: none; }
  :global(html.con-intro) { overflow: hidden; }
  :global(html.con-intro) .intro {
    position: fixed; inset: 0; z-index: 100;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px;
    background:
      radial-gradient(500px 400px at 50% 45%, rgba(95, 211, 141, 0.10), transparent 70%),
      var(--bg);
    cursor: pointer;
    transition: opacity .7s ease, visibility .7s ease;
  }
  .escena { position: relative; width: min(260px, 60vw); aspect-ratio: 1; perspective: 900px; }
  .moneda { width: 100%; height: 100%; transform-style: preserve-3d; animation: girar 2s cubic-bezier(.2, .7, .2, 1) both; }
  .moneda :global(img) { width: 100%; height: 100%; border-radius: 50%; filter: drop-shadow(0 0 40px rgba(95, 211, 141, 0.35)); }
  .brillo {
    position: absolute; inset: -18%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(127, 216, 232, 0.35), transparent 60%);
    opacity: 0; animation: destello 1s ease-out 1.6s both;
  }
  .marca {
    margin: 0; font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.08em; font-size: clamp(1rem, 3.4vw, 1.4rem); color: var(--text);
    opacity: 0; animation: aparecer .7s ease 1.3s both;
  }
  .marca b { color: var(--orange); }
  .saltar-intro {
    position: absolute; bottom: calc(28px + env(safe-area-inset-bottom, 0px)); margin: 0;
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); opacity: 0;
    animation: aparecer .5s ease .8s both;
  }
  .intro.saliendo { opacity: 0; visibility: hidden; }
  .intro.saliendo .moneda { transform: scale(1.25); filter: blur(6px); transition: transform .7s ease, filter .7s ease; animation: none; }

  @keyframes girar {
    0% { transform: rotateY(0deg) scale(0.4); opacity: 0; }
    15% { opacity: 1; }
    100% { transform: rotateY(1080deg) scale(1); opacity: 1; }
  }
  @keyframes destello {
    0% { opacity: 0; transform: scale(0.8); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: scale(1.3); }
  }
  @keyframes aparecer {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .moneda, .brillo, .marca, .saltar-intro { animation: none; opacity: 1; }
    .brillo { opacity: 0; }
  }
</style>
