---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { sitio, linkWhatsapp } from '../data/sitio';

const links = [
  { href: '/#servicios', num: '01', texto: 'Servicios' },
  { href: '/#trabajos', num: '02', texto: 'Trabajos' },
  { href: '/#evolucion', num: '03', texto: 'Proceso' },
  { href: '/#sobre-mi', num: '04', texto: 'Sobre mí' },
];
---
<header class="header">
  <div class="inner">
    <a href="/" class="marca" aria-label={`${sitio.nombre}, inicio`}>
      <Image src={logo} alt="" width={34} height={34} densities={[1, 2]} loading="eager" />
      <span>Código<b>&amp;</b>Evolución</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href}><small>{l.num}</small>{l.texto}</a></li>)}
      </ul>
    </nav>
    <a class="hablemos" href={linkWhatsapp()} target="_blank" rel="noopener">Hablemos <span aria-hidden="true">↗</span></a>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 30;
    background: rgba(8, 16, 28, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--linea-fuerte);
  }
  .inner { display: flex; align-items: stretch; min-height: 58px; }
  .marca {
    display: flex; align-items: center; gap: 10px; padding: 0 var(--gutter);
    border-right: 1px solid var(--linea-fuerte); text-decoration: none;
    font-family: var(--font-display); font-weight: 800; font-size: 1.15rem;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .marca b { color: var(--naranja); margin: 0 3px; }
  nav { flex: 1; display: flex; }
  ul { display: flex; list-style: none; margin: 0; padding: 0; }
  li { display: flex; border-right: 1px solid var(--linea); }
  nav a {
    display: flex; align-items: center; gap: 8px; padding: 0 22px;
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--tenue); text-decoration: none; transition: color .2s ease, background .2s ease;
  }
  nav a small { color: var(--naranja); font-size: 0.68rem; }
  nav a:hover { color: var(--texto); background: rgba(150, 180, 220, 0.06); }
  .hablemos {
    display: flex; align-items: center; gap: 8px; padding: 0 var(--gutter);
    background: var(--verde); color: var(--tinta); text-decoration: none;
    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
    transition: background .2s ease;
  }
  .hablemos:hover { background: var(--papel); }
  @media (max-width: 960px) {
    nav { display: none; }
    .marca { flex: 1; border-right: 0; }
  }
  @media (max-width: 400px) {
    .marca { font-size: 1rem; gap: 8px; }
    .hablemos { padding: 0 14px; }
  }
</style>
