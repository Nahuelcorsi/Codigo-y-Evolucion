---
import IconoWhatsapp from './IconoWhatsapp.astro';
import { linkWhatsapp } from '../data/sitio';
---
<a class="wa-flotante" href={linkWhatsapp()} target="_blank" rel="noopener" aria-label="Escribime por WhatsApp">
  <IconoWhatsapp size={26} />
  <span>Escribime</span>
</a>

<style>
  .wa-flotante {
    position: fixed; z-index: 30;
    right: calc(20px + env(safe-area-inset-right, 0px));
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    display: inline-flex; align-items: center; gap: 10px;
    padding: 14px; border-radius: 999px;
    background: #25d366; color: #062b14; font-weight: 600; font-size: 0.95rem;
    box-shadow: 0 10px 30px -8px rgba(37, 211, 102, 0.55), 0 2px 6px rgba(0, 0, 0, 0.3);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .wa-flotante:hover { text-decoration: none; transform: translateY(-2px); box-shadow: 0 14px 34px -8px rgba(37, 211, 102, 0.7), 0 2px 6px rgba(0, 0, 0, 0.3); }
  .wa-flotante span { padding-right: 6px; }
  @media (max-width: 640px) { .wa-flotante span { display: none; } }
</style>
